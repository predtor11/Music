# Copy to .env and fill in. Never commit .env.

# Supabase project (Project settings > Database / API)
SUPABASE_URL=https://iecxugzgkupflnayweyx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# The web app's sign-in (public values; the browser sees these, so only the anon/publishable key)
VITE_SUPABASE_URL=https://iecxugzgkupflnayweyx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Postgres connection string; each service uses its own schema in this database
SUPABASE_DB_URL=

# Event bus
REDIS_URL=redis://localhost:6379

# Serverless deploy (Vercel): see docs/DEPLOY.md. SUPABASE_DB_URL should be the
# transaction pooler string there. API_DEV_MODE=1 lets `npm run api` run without sign-in (local only).
# API_DEV_MODE=1
