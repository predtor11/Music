# Copy to .env and fill in. Never commit .env.

# Supabase project (Project settings > Database / API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Postgres connection string; each service uses its own schema in this database
SUPABASE_DB_URL=

# Event bus
REDIS_URL=redis://localhost:6379
