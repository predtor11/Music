{
  "name": "@music/api",
  "version": "0.1.0",
  "private": true,
  "description": "The whole backend as one serverless function (Vercel): the gateway and every service in one process, Postgres only",
  "type": "module",
  "scripts": {
    "bundle": "node build.mjs",
    "start": "tsx src/local.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@music/contracts": "*",
    "@music/service-kit": "*",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
