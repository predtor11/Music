{
  "id": "u2-l1",
  "unitId": "unit-2",
  "order": 1,
  "title": "Half steps and whole steps",
  "summary": "The two smallest moves on the keyboard, and the building blocks of every interval.",
  "minutes": 6,
  "steps": [
    {
      "type": "explain",
      "title": "The smallest step",
      "body": "A **half step** is the move from one key to the very next key, black or white, with nothing in between.\n\nC to C♯ is a half step. So is E to F, because there is no black key between them.",
      "exampleMidi": [
        60,
        61
      ],
      "labels": {
        "60": "C",
        "61": "C♯"
      }
    },
    {
      "type": "show",
      "title": "Half steps between white keys",
      "body": "E to F and B to C are the only places where two white keys are a half step apart.",
      "highlightMidi": [
        64,
        65,
        71,
        72
      ],
      "labels": {
        "64": "E",
        "65": "F",
        "71": "B",
        "72": "C"
      }
    },
    {
      "type": "explain",
      "title": "Two half steps make a whole step",
      "body": "A **whole step** skips over one key. C to D is a whole step, with C♯ in between. E to F♯ is also a whole step, with F in between.",
      "exampleMidi": [
        60,
        62
      ],
      "labels": {
        "60": "C",
        "62": "D"
      }
    },
    {
      "type": "show",
      "title": "A chain of whole steps",
      "body": "C, D, E, F♯: each key is a whole step above the one before it.",
      "highlightMidi": [
        60,
        62,
        64,
        66
      ],
      "labels": {
        "60": "C",
        "62": "D",
        "64": "E",
        "66": "F♯"
      }
    },
    {
      "type": "play-along",
      "title": "Step up and down",
