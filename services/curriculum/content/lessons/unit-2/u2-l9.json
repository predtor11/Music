  "title": "Sixths",
  "summary": "A 6th spans six letters. Minor 6ths are bittersweet and major 6ths are warm.",
  "minutes": 5,
  "steps": [
    {
      "type": "explain",
      "title": "Minor 6th",
      "body": "Count six letters from C and you reach A, so C to A is a 6th. A **minor 6th** is 8 half steps, like C to A♭.\n\n**Why it matters:** It has a bittersweet sound, and it turns up in a lot of film and love-song melodies.",
      "exampleMidi": [
        60,
        68
      ],
      "labels": {
        "60": "C",
        "68": "minor 6th"
      }
    },
    {
      "type": "explain",
      "title": "Major 6th",
      "body": "A **major 6th** is 9 half steps, like C to A.\n\n**Why it matters:** It sounds warm and sweet, and it is the sound of many harmony lines. My Bonnie Lies Over the Ocean opens with one.",
      "exampleMidi": [
        60,
        69
      ],
      "labels": {
        "60": "C",
        "69": "major 6th"
      }
    },
    {
      "type": "show",
      "title": "Sixths above C",
      "body": "A♭ is a minor 6th above C, and A is a major 6th.",
      "highlightMidi": [
        60,
        68,
        69
      ],
      "labels": {
        "60": "C",
        "68": "minor 6th",
        "69": "major 6th"
      }
