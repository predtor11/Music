  "title": "Silence",
  "summary": "A rest is a beat of silence, and it counts just as much as a note.",
  "minutes": 5,
  "steps": [
    {
      "type": "explain",
      "title": "Rest",
      "body": "A **rest** is a written silence: you keep counting but play nothing. Each note length has a rest of the same length: a quarter rest is one beat of silence.\n\n**Why it matters:** Rests are what make a rhythm groove. The gaps between notes matter as much as the notes.",
      "exampleMidi": [
        60
      ],
      "labels": {
        "60": "1 2 (rest) 4"
      }
    },
    {
      "type": "show",
      "title": "Count through the gap",
      "body": "Tap on 1, 2 and 4, and stay silent on 3, still counting it.",
      "highlightMidi": [
        60
      ],
      "labels": {
        "60": "1 2 _ 4"
      }
    },
